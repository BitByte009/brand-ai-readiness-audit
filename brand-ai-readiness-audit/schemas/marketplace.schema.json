{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Challenge marketplace manifest (project contract, not an Agent Skills standard)",
  "type": "object",
  "required": ["name", "version", "description", "skills"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "skills": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "path"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "boolean"}
        }
      },
      "contains": {"type": "object", "required": ["entrypoint"], "properties": {"entrypoint": {"const": true}}},
      "minContains": 1, "maxContains": 1
    }
  }
}
